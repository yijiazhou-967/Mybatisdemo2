<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
        "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.music.mapper.AlbumMapper">

    <!-- 任务二：显式结果映射，与全局驼峰映射对照学习 -->
    <resultMap id="albumMap" type="Album">
        <id property="albumId" column="album_id"/>
        <result property="title" column="title"/>
        <result property="artist" column="artist"/>
        <result property="genre" column="genre"/>
        <result property="price" column="price"/>
        <result property="stock" column="stock"/>
        <result property="releaseDate" column="release_date"/>
        <result property="status" column="status"/>
    </resultMap>

    <!-- 全字段列表，供各 SQL 片段复用 -->
    <sql id="allColumns">
        album_id, title, artist, genre, price, stock, release_date, status
    </sql>

    <!-- ============ 任务二：基础 CRUD ============ -->

    <!-- 查询全部，按主键升序 -->
    <select id="selectAll" resultMap="albumMap">
        SELECT <include refid="allColumns"/>
        FROM album
        ORDER BY album_id
    </select>

    <!-- 按主键查询单条 -->
    <select id="selectById" resultMap="albumMap">
        SELECT <include refid="allColumns"/>
        FROM album
        WHERE album_id = #{albumId}
    </select>

    <!-- 新增，并回填自增主键到 albumId -->
    <insert id="insert" parameterType="Album" useGeneratedKeys="true" keyProperty="albumId">
        INSERT INTO album (title, artist, genre, price, stock, release_date, status)
        VALUES (#{title}, #{artist}, #{genre}, #{price}, #{stock}, #{releaseDate,jdbcType=DATE}, #{status})
    </insert>

    <!-- 按主键整体更新 -->
    <update id="update" parameterType="Album">
        UPDATE album
        SET title = #{title},
            artist = #{artist},
            genre = #{genre},
            price = #{price},
            stock = #{stock},
            release_date = #{releaseDate,jdbcType=DATE},
            status = #{status}
        WHERE album_id = #{albumId}
    </update>

    <!-- 按主键删除 -->
    <delete id="deleteById">
        DELETE FROM album WHERE album_id = #{albumId}
    </delete>

    <!-- ============ 任务三：动态 SQL ============ -->

    <sql id="conditionFilters">
        <if test="title != null and title != ''">
            AND title LIKE CONCAT('%', #{title}, '%')
        </if>
        <if test="artist != null and artist != ''">
            AND artist LIKE CONCAT('%', #{artist}, '%')
        </if>
        <if test="genre != null and genre != ''">
            AND genre = #{genre}
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
    </sql>

    <!-- 3.1 多条件模糊查询：where 标签自动剔除开头多余的 AND -->
    <select id="selectByCondition" parameterType="Album" resultMap="albumMap">
        SELECT <include refid="allColumns"/> FROM album
        <where><include refid="conditionFilters"/></where>
        ORDER BY album_id
    </select>

    <!-- trim 与 where 等效，共用条件片段，避免两份条件逻辑不同 -->
    <select id="selectByConditionWithTrim" parameterType="Album" resultMap="albumMap">
        SELECT <include refid="allColumns"/> FROM album
        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <include refid="conditionFilters"/>
        </trim>
        ORDER BY album_id
    </select>

    <!-- 3.2 动态更新：set 标签只更新非空字段，自动去除末尾多余逗号 -->
    <update id="updateSelectiveRows" parameterType="Album">
        UPDATE album
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="artist != null">artist = #{artist},</if>
            <if test="genre != null">genre = #{genre},</if>
            <if test="price != null">price = #{price},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="releaseDate != null">release_date = #{releaseDate},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE album_id = #{albumId}
    </update>

    <!-- 3.3 批量删除：foreach 拼接 IN (...) -->
    <delete id="deleteBatchRows">
        DELETE FROM album WHERE album_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 3.3 批量插入：foreach 拼接多组 VALUES -->
    <insert id="insertBatchRows">
        INSERT INTO album (title, artist, genre, price, stock, release_date, status) VALUES
        <foreach collection="albums" item="a" separator=",">
            (#{a.title}, #{a.artist}, #{a.genre}, #{a.price}, #{a.stock}, #{a.releaseDate,jdbcType=DATE}, #{a.status})
        </foreach>
    </insert>

    <!-- 3.4 分支选择：优先标题精确，其次歌手精确，否则查询全部 -->
    <select id="selectSmart" parameterType="Album" resultMap="albumMap">
        SELECT <include refid="allColumns"/>
        FROM album
        <where>
            <choose>
                <when test="title != null and title != ''">
                    AND title = #{title}
                </when>
                <when test="artist != null and artist != ''">
                    AND artist = #{artist}
                </when>
                <otherwise>
                    AND 1 = 1
                </otherwise>
            </choose>
        </where>
        ORDER BY album_id
    </select>

</mapper>
